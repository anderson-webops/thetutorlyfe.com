# Local API listener. The direct production service pins loopback and one proxy hop.
HOST=127.0.0.1
PORT=3006
TRUST_PROXY_HOPS=0

# Nuxt development proxy target. The browser still calls the same-origin /api path.
DEV_API_ORIGIN=http://127.0.0.1:3006

# HTTPS endpoint owned by the new site operator. The API forwards validated lead
# submissions here as application/x-www-form-urlencoded data. Leave blank until
# the destination has been created and verified; never reuse the former public
# Google Apps Script URL without separately confirming ownership and access.
LEAD_WEBHOOK_URL=
