{
  "version": 1,
  "entrypoints": [
    "back-end/dist/server.js"
  ],
  "required": [
    "package.json",
    "package-lock.json",
    "back-end/package.json",
    "back-end/package-lock.json",
    "front-end/package.json",
    ".tutorlyfe-release-prepared.json",
    "back-end/dist/server.js",
    "back-end/dist/app.js",
    "back-end/dist/server-config.js",
    "back-end/dist/boundedRateStore.js",
    "front-end/.output/public/index.html",
    "front-end/.output/public/200.html",
    "front-end/.output/public/404.html",
    "front-end/.output/public/release.json"
  ],
  "runtime": {
    "os": "linux",
    "arch": "arm64",
    "node": "26.13.0",
    "npmBuildOnly": "12.2.1"
  },
  "deployment": {
    "schemaVersion": 1,
    "applicationId": "thetutorlyfe.com",
    "artifactFormat": "vitesse-direct-runtime-v1",
    "requiredHostCapabilities": [
      "artifact-only-promotion-v1",
      "verified-source-and-payload-v1",
      "protected-immutable-staging-v1",
      "retained-artifact-rollback-v1",
      "version-aware-readiness-v1",
      "dual-stack-release-identity-v1"
    ],
    "probes": {
      "apiHealth": { "path": "/api/health", "methods": ["GET", "HEAD"], "success": 200 },
      "apiReadiness": { "path": "/api/readyz", "methods": ["GET", "HEAD"], "success": 200, "failure": 503 },
      "staticIdentity": { "path": "/release.json", "field": "commitSha", "addressFamilies": ["ipv4", "ipv6"] }
    },
    "migrations": "none",
    "rollback": "verify-retained-artifact-and-identity",
    "hostControlled": ["service-user", "listener", "reverse-proxy", "protected-environment"]
  },
  "modulesOutsideDist": [],
  "generatedClients": [],
  "nativeBindings": [],
  "staticAssets": [
    "front-end/.output/public"
  ],
  "dependencyRoots": [
    "back-end"
  ],
  "writableState": [
    {
      "name": "logs",
      "location": "existing service journal",
      "rollback": "preserve the journal; the application has no writable release-local state or migrations"
    }
  ],
  "privateConfiguration": "LEAD_WEBHOOK_URL remains in the protected host environment. Credentials, lead data, caches, and environment files are excluded from immutable artifacts.",
  "topology": "Static Nuxt output plus the independent compiled The Tutor Lyfe Express lead API on loopback port 3006. Preserve installed users, paths, IPv4/IPv6 edge listeners, and the separate Netlify adapter."
}
