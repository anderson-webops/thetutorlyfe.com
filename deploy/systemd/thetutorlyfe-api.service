[Unit]
Description=The Tutor Lyfe API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=thetutorlyfe
Group=thetutorlyfe
WorkingDirectory=/srv/thetutorlyfe.com/current
EnvironmentFile=-/etc/thetutorlyfe.com/api.env
Environment=HOST=127.0.0.1
Environment=NODE_ENV=production
Environment=PORT=3006
Environment=TRUST_PROXY_HOPS=1
ExecStart=/usr/bin/node back-end/dist/server.js
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=20s
UMask=0077

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProtectSystem=strict
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
