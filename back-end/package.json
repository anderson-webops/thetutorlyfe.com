{
	"name": "thetutorlyfe-api",
	"version": "1.0.1",
	"private": true,
	"description": "Same-origin health and lead-delivery API for The Tutor Lyfe.",
	"type": "module",
	"packageManager": "npm@12.2.1",
	"allowScripts": {
		"esbuild@0.28.2": true,
		"fsevents@2.3.3": true
	},
	"engines": {
		"node": ">=26.13.0 <27",
		"npm": ">=12.2.1 <13"
	},
	"main": "dist/server.js",
	"scripts": {
		"server": "tsx watch -r dotenv/config src/server.ts",
		"server:once": "tsx -r dotenv/config src/server.ts",
		"start": "node dist/server.js",
		"build": "tsc -p tsconfig.json",
		"watch": "tsc -w",
		"dev": "tsx watch -r dotenv/config src/server.ts",
		"typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
		"test": "vitest run",
		"lint": "eslint \"{src,test}/**/*.{js,ts}\"",
		"lint-fix": "eslint \"{src,test}/**/*.{js,ts}\" --fix"
	},
	"keywords": [],
	"author": "Jacob Anderson",
	"license": "MIT",
	"dependencies": {
		"dotenv": "^18.0.9",
		"express": "^5.3.0",
		"express-rate-limit": "^8.7.3",
		"helmet": "^8.3.0",
		"qs": "file:vendor/qs-6.17.2-webops.1.tgz"
	},
	"overrides": {
		"minimatch": "11.0.3",
		"nanoid@^3": "3.3.18",
		"qs": "$qs"
	},
	"devDependencies": {
		"@types/express": "^5.0.6",
		"@types/node": "^26.6.6",
		"@types/supertest": "^7.2.1",
		"globals": "^17.14.0",
		"supertest": "^7.3.1",
		"tsx": "^4.23.15",
		"typescript-eslint": "^8.72.1",
		"vitest": "^5.1.0"
	}
}
